{
  "name": "sequelize-encryption-hooks",
  "version": "0.1.0",
  "description": "Transparent field-level encryption for Sequelize models — AES-256-GCM encryption on write, decryption on read, via lifecycle hooks. Optional HMAC blind indexes for exact-match queries.",
  "keywords": [
    "sequelize",
    "encryption",
    "hooks",
    "aes-256-gcm",
    "field-encryption",
    "encrypted-attributes",
    "blind-index",
    "orm",
    "security",
    "pii"
  ],
  "license": "MIT",
  "author": {
    "name": "Satyendra Sagar Singh",
    "email": "satyendra.sagar@icloud.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/satyendra-sagar-singh/sequelize-encryption-hooks.git"
  },
  "homepage": "https://github.com/satyendra-sagar-singh/sequelize-encryption-hooks#readme",
  "bugs": {
    "url": "https://github.com/satyendra-sagar-singh/sequelize-encryption-hooks/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:package": "publint && attw --pack .",
    "prepublishOnly": "npm run typecheck && npm run test:coverage && npm run build && npm run check:package"
  },
  "peerDependencies": {
    "sequelize": "^6.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.4",
    "publint": "^0.3.21",
    "sequelize": "^6.37.0",
    "sqlite3": "^6.0.1",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
